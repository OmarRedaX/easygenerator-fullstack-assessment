{
  "name": "easygenerator-assessment",
  "private": true,
  "workspaces": ["backend", "frontend"],
  "engines": { "node": ">=22" },
  "scripts": {
    "lint": "npm run lint -w backend",
    "typecheck": "npm run typecheck -w backend",
